    "./iem": {
      "types": "./dist/iem.d.ts",
      "import": "./dist/iem.js"
    },
    "./nws": {
      "types": "./dist/nws.d.ts",
      "import": "./dist/nws.js"
    },
    "./eccc": {
      "types": "./dist/eccc.d.ts",
      "import": "./dist/eccc.js"
    },
    "./ndbc": {
      "types": "./dist/ndbc.d.ts",
      "import": "./dist/ndbc.js"
