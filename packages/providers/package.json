      "types": "./dist/awc.d.ts",
      "import": "./dist/awc.js"
    },
    "./windsmobi": {
      "types": "./dist/windsmobi.d.ts",
      "import": "./dist/windsmobi.js"
    },
    "./windspion": {
      "types": "./dist/windspion.d.ts",
      "import": "./dist/windspion.js"
    },
    "./windguru": {
      "types": "./dist/windguru.d.ts",
      "import": "./dist/windguru.js"
    },
    "./windtalkers": {
      "types": "./dist/windtalkers.d.ts",
      "import": "./dist/windtalkers.js"
    },
    "./raws": {
      "types": "./dist/raws.d.ts",
