{
  "name": "@stations/geography",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Geographic positions, bounding boxes, regional coverages, and spatial indexing for weather stations",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./regions": {
      "types": "./dist/regions.d.ts",
      "import": "./dist/regions.js"
    },
    "./spatial-index": {
      "types": "./dist/spatial-index.d.ts",
      "import": "./dist/spatial-index.js"
    },
    "./build-inventory.json": "./dist/build-inventory.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs @stations/geography",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs"
  }
}
