{
  "name": "stations-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "node scripts/build-packages.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:api": "node scripts/check-api.mjs",
    "test:packages": "pnpm build:packages && node --test packages/*/test/*.test.mjs",
    "test:consumer": "pnpm build:packages && node scripts/test-consumer.mjs",
    "check:worker": "wrangler types deploy/worker/worker-configuration.d.ts --include-runtime=false --strict-vars=false && tsc -p deploy/worker/tsconfig.json --noEmit",
    "check:web": "tsc -p web/tsconfig.xct.json",
    "check": "pnpm build:packages && pnpm check:boundaries && pnpm check:api && pnpm check:worker && pnpm check:web",
    "test": "pnpm build:packages && node --test packages/*/test/*.test.mjs scripts/test/*.test.mjs deploy/worker/test/*.test.mjs",
    "verify": "pnpm check && node --test packages/*/test/*.test.mjs scripts/test/*.test.mjs deploy/worker/test/*.test.mjs && node scripts/test-consumer.mjs",
    "build:web": "pnpm build:packages && node scripts/build-web.mjs",
    "build": "pnpm build:packages && node scripts/build-web.mjs",
    "dev": "pnpm build:web && node scripts/serve-explorer.mjs",
    "dev:worker": "pnpm build && wrangler dev",
    "deploy:catalogue": "pnpm build:packages && node scripts/export-deploy-catalogue.mjs",
    "catalogue:build": "pnpm build:packages && node scripts/build-catalogue.mjs",
    "catalogue:crawl": "pnpm build:packages && node scripts/crawl-na.mjs",
    "wu:bridge": "node scripts/bridge-wn55-to-wu.mjs",
    "test:scripts": "pnpm build:packages && node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "@azohra/meteo.station": "0.7.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@stations/client": "workspace:*",
    "@stations/contracts": "workspace:*",
    "@stations/geography": "workspace:*",
    "@stations/providers": "workspace:*",
    "@types/node": "24.10.1",
    "esbuild": "0.25.0",
    "maplibre-gl": "6.14.0",
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
